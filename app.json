{
  "expo": {
    "name": "Instagram Clon",
    "slug": "instagram-clon-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "assetBundlePatterns": ["**/*"],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.instagramclon.app"
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#833AB4"
      },
      "package": "com.instagramclon.app"
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "statusBar": {
      "style": "dark",
      "backgroundColor": "#ffffff"
    }
  }
}
